{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in tomorrow",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "User identifier"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200,
          "description": "User email address"
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "description": "Full name or nickname"
        },
        "role": {
          "type": "string",
          "maxLength": 80,
          "description": "Role in the community"
        },
        "country": {
          "type": "string",
          "maxLength": 80,
          "description": "Country of origin or residence"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "name", "role", "createdAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public developer or member brief portfolio without private PII",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "User identifier"
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name"
        },
        "role": {
          "type": "string",
          "maxLength": 80,
          "description": "Community role"
        },
        "country": {
          "type": "string",
          "maxLength": 80,
          "description": "African country"
        },
        "headline": {
          "type": "string",
          "maxLength": 120,
          "description": "Short specialty headline"
        },
        "bio": {
          "type": "string",
          "maxLength": 450,
          "description": "Brief portfolio presentation"
        },
        "githubUrl": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional GitHub profile URL"
        },
        "websiteUrl": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional website URL"
        },
        "availability": {
          "type": "string",
          "enum": ["Disponible", "Ouvert aux collabs", "Occupé"],
          "description": "Collaboration availability"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Last portfolio update timestamp"
        }
      },
      "required": ["id", "name", "role", "country", "availability", "updatedAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Connection invitation sent before opening a short text conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique invitation ID"
        },
        "fromUserId": {
          "type": "string",
          "maxLength": 128,
          "description": "Sender user ID"
        },
        "fromUserName": {
          "type": "string",
          "maxLength": 120,
          "description": "Sender display name"
        },
        "toUserId": {
          "type": "string",
          "maxLength": 128,
          "description": "Recipient user ID"
        },
        "toUserName": {
          "type": "string",
          "maxLength": 120,
          "description": "Recipient display name"
        },
        "note": {
          "type": "string",
          "maxLength": 240,
          "description": "Optional short invitation message"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined"],
          "description": "Invitation status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation timestamp"
        },
        "respondedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Acceptance or decline timestamp"
        }
      },
      "required": ["id", "fromUserId", "fromUserName", "toUserId", "toUserName", "status", "createdAt"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Short text message exchanged after an accepted connection invitation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique message ID"
        },
        "conversationId": {
          "type": "string",
          "maxLength": 260,
          "description": "Deterministic conversation thread ID"
        },
        "senderId": {
          "type": "string",
          "maxLength": 128,
          "description": "Sender user ID"
        },
        "senderName": {
          "type": "string",
          "maxLength": 120,
          "description": "Sender display name"
        },
        "recipientId": {
          "type": "string",
          "maxLength": 128,
          "description": "Recipient user ID"
        },
        "text": {
          "type": "string",
          "maxLength": 500,
          "description": "Short message body"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "conversationId", "senderId", "senderName", "recipientId", "text", "createdAt"]
    },
    "KeepNote": {
      "title": "KeepNote",
      "description": "User note or checklist synced with tomorrow Notes / Google Keep",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique note ID"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner user ID"
        },
        "title": {
          "type": "string",
          "maxLength": 160,
          "description": "Note title"
        },
        "body": {
          "type": "string",
          "maxLength": 3000,
          "description": "Text note content"
        },
        "isChecklist": {
          "type": "boolean",
          "description": "Whether the note is a checklist"
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether the note is pinned"
        },
        "linkedAppId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional linked tomorrow App ID"
        },
        "linkedAppTitle": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional linked tomorrow App title"
        },
        "source": {
          "type": "string",
          "enum": ["local", "takeout", "google_keep_api"],
          "description": "Origin of the note"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "ownerId", "title", "isChecklist", "pinned", "source", "updatedAt"]
    },
    "App": {
      "title": "App",
      "description": "Application concept document in tomorrow",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique app ID"
        },
        "title": {
          "type": "string",
          "maxLength": 140,
          "description": "Title of the application"
        },
        "tagline": {
          "type": "string",
          "maxLength": 240,
          "description": "One sentence summary"
        },
        "description": {
          "type": "string",
          "maxLength": 3000,
          "description": "Detailed description of the application"
        },
        "continent": {
          "type": "string",
          "maxLength": 32,
          "description": "Geographic continent (Afrique)"
        },
        "country": {
          "type": "string",
          "maxLength": 80,
          "description": "Target African country"
        },
        "sector": {
          "type": "string",
          "maxLength": 80,
          "description": "Domain sector"
        },
        "problemSolved": {
          "type": "string",
          "maxLength": 1500,
          "description": "Identified ground problem"
        },
        "votes": {
          "type": "number",
          "description": "Total community votes"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Submission timestamp"
        }
      },
      "required": ["title", "tagline", "continent", "country", "sector", "problemSolved", "votes", "createdAt"]
    },
    "Build": {
      "title": "Build",
      "description": "Collaborative developer or AI-generated implementation build for a tomorrow project",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique build identifier"
        },
        "appId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent application concept ID"
        },
        "appTitle": {
          "type": "string",
          "maxLength": 160,
          "description": "Parent application title"
        },
        "title": {
          "type": "string",
          "maxLength": 160,
          "description": "Build or squad title"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000,
          "description": "Progress summary and build notes"
        },
        "progressStage": {
          "type": "string",
          "enum": ["Concept", "Prototype", "Alpha", "Beta", "Production"],
          "description": "Current lifecycle stage"
        },
        "progressPercent": {
          "type": "number",
          "description": "Completion percentage 0-100"
        },
        "isGroupProject": {
          "type": "boolean",
          "description": "Whether open to small group squad collaboration"
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether public render link is accessible to all visitors"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Creator user ID"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 120,
          "description": "Creator display name"
        },
        "githubUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional repository URL"
        },
        "activeVersionId": {
          "type": "string",
          "maxLength": 128,
          "description": "Currently published version ID"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "appId", "appTitle", "title", "progressStage", "progressPercent", "isGroupProject", "isPublic", "ownerId", "ownerName", "activeVersionId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of private user profiles keyed by user ID"
    },
    "/public_profiles/{profileId}": {
      "schema": "PublicProfile",
      "description": "Public brief portfolios without PII for developers and members"
    },
    "/invitations/{invitationId}": {
      "schema": "Invitation",
      "description": "Connection invitations between members"
    },
    "/messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Short text messages between connected members"
    },
    "/notes/{noteId}": {
      "schema": "KeepNote",
      "description": "Personal notes and checklists synced for Google Keep workflow"
    },
    "/apps/{appId}": {
      "schema": "App",
      "description": "Collection of community and AI applications for Africa"
    },
    "/builds/{buildId}": {
      "schema": "Build",
      "description": "Collection of collaborative developer builds, versions, squads, and AI prototypes"
    }
  }
}
